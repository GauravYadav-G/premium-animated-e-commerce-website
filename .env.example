# Existing PostgreSQL catalog/cart configuration, optional for local preview.
DATABASE_URL=
USE_MOCK_DATA=true

# Keep these server-side. Use matching Razorpay test credentials for development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Persistent single-instance order database. Never place this under public/.
COMMERCE_DB_PATH=.data/commerce.sqlite
FULFILLMENT_ADMIN_TOKEN=

# Supply real business details before issuing customer invoices.
SELLER_NAME=
SELLER_ADDRESS=
SELLER_EMAIL=
SELLER_GSTIN=
